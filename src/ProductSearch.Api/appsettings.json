{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"

  // Connection settings come from environment variables with local-development
  // defaults (see Env.cs). To override without touching the environment, add:
  //
  //   "Elasticsearch": { "Url": "...", "Username": "...", "Password": "..." },
  //   "ConnectionStrings": { "SqlServer": "..." }
  //
  // Never commit real credentials here - use a secret store in production.
}
